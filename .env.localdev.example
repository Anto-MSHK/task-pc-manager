# Local development: DBs in Docker, Nest + Vite run natively.
# Ports match the host-mapped ports from docker-compose.yml defaults.
# Copy this file to .env inside the backend/ folder.

# MongoDB (replica set required for transactions)
MONGODB_URI=mongodb://localhost:27018/promocodes?replicaSet=rs0&directConnection=true

# ClickHouse
CLICKHOUSE_HOST=http://localhost:8124
CLICKHOUSE_DB=promocodes_db
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=secret

# Backend
PORT=3000
JWT_ACCESS_SECRET=access-secret-key-123
JWT_REFRESH_SECRET=refresh-secret-key-456
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Frontend — set in frontend/.env or frontend/.env.local
# VITE_API_URL=http://localhost:3000
